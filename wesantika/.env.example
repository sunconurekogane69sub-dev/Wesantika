# --- Site ------------------------------------------------------------------
# Absolute origin, used to emit absolute canonical, hreflang and og:image URLs.
# Crawlers ignore relative ones, so this must be the real origin in production.
#
# NEXT_PUBLIC_* is inlined at BUILD time: setting it as a runtime-only variable
# has no effect. On Vercel, tick every environment when you add it.
#
# If it is missing on Vercel, src/lib/site.ts falls back to
# VERCEL_PROJECT_PRODUCTION_URL so a deployment never ships metadata pointing
# at localhost. Set this anyway — the fallback is a safety net, not the plan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form ---------------------------------------------------------
# Where enquiries are delivered. `.example` is an RFC 2606 reserved TLD, so
# this placeholder can never reach a real inbox by accident. Replace it with
# the real address before launch.
CONTACT_TO_EMAIL=contact@wesantika.example
CONTACT_FROM_EMAIL=no-reply@wesantika.example

# --- SMTP -----------------------------------------------------------------
# Leave these BLANK for development. With no SMTP configured, the API route
# provisions a disposable Ethereal mailbox at runtime: the message is really
# sent over SMTP and the response carries a `previewUrl` where you can read
# the delivered mail in a browser.
#
# Fill them in for production and the same code path switches to your server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- RFP modal -------------------------------------------------------------
# Where RFP submissions are delivered. Falls back to CONTACT_TO_EMAIL when
# unset. ** Set this to the real address before launch. **
RFP_TO_EMAIL=

# --- Cloudflare Turnstile (spam protection on the RFP form) ----------------
# Left blank, the app uses Cloudflare's documented "always passes" test keys, so
# the widget renders and the server-side verification runs exactly as it will in
# production. Create a Turnstile site at
# https://dash.cloudflare.com/?to=/:account/turnstile and paste the real pair
# here before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
