# --- Site ------------------------------------------------------------------
# Absolute origin, used to emit absolute canonical and hreflang URLs. Crawlers
# ignore relative alternates, so this must be set to the real origin in
# production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form ---------------------------------------------------------
# Where enquiries are delivered. `.example` is an RFC 2606 reserved TLD, so
# this placeholder can never reach a real inbox by accident. Replace it with
# the real address before launch.
CONTACT_TO_EMAIL=contact@wesantika.example
CONTACT_FROM_EMAIL=no-reply@wesantika.example

# --- SMTP -----------------------------------------------------------------
# Leave these BLANK for development. With no SMTP configured, the API route
# provisions a disposable Ethereal mailbox at runtime: the message is really
# sent over SMTP and the response carries a `previewUrl` where you can read
# the delivered mail in a browser.
#
# Fill them in for production and the same code path switches to your server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
